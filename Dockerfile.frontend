# ── Build stage: compile React app ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ── Runtime stage: serve static files with Nginx ─────────────────────────────
FROM nginx:alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config: all routes → index.html (React Router compatibility)
#
# proxy_pass target is the backend Container App's name, resolved via the
# Container Apps environment's internal DNS (apps in the same environment
# reach each other by name) — NOT a made-up hostname. If the backend
# Container App is ever renamed, this must be updated to match, since it's
# baked into the image at build time.
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
  location /api/ {\n\
    proxy_pass http://ca-backend-pil-dev63u6v3/;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
