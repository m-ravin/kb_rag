# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Get from: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-api-key-here
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Get from: Azure Portal → your Search resource → Keys
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_KEY=your-search-api-key-here
AZURE_SEARCH_INDEX_NAME=kb-documents

# ── Cosmos DB — MongoDB API ────────────────────────────────────────────────────
# Get from: Azure Portal → Cosmos DB → Connection Strings
COSMOS_MONGO_CONNECTION=mongodb://YOUR-ACCOUNT:KEY@YOUR-ACCOUNT.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb
COSMOS_DB_NAME=kb-knowledge-base

# ── Cosmos DB — Gremlin API ────────────────────────────────────────────────────
COSMOS_GREMLIN_ENDPOINT=wss://YOUR-ACCOUNT.gremlin.cosmos.azure.com:443/
COSMOS_GREMLIN_KEY=your-cosmos-primary-key
COSMOS_GREMLIN_DATABASE=kb-graph
COSMOS_GREMLIN_GRAPH=chunk-graph

# ── Azure Cache for Redis ─────────────────────────────────────────────────────
# Get from: Azure Portal → Redis → Access keys
REDIS_CONNECTION=rediss://:your-redis-key@YOUR-REDIS.redis.cache.windows.net:6380

# ── Azure Data Lake Storage ───────────────────────────────────────────────────
STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=YOUR-ACCOUNT;AccountKey=YOUR-KEY;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=kb-documents

# ── Azure AI Content Safety ───────────────────────────────────────────────────
# Optional — if blank, falls back to local regex PII detection
CONTENT_SAFETY_ENDPOINT=https://YOUR-CONTENT-SAFETY.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=your-content-safety-key

# ── Azure Monitor / App Insights ──────────────────────────────────────────────
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx.applicationinsights.azure.com/

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
