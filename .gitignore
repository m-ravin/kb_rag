# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
.env.local
.env.generated
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/
htmlcov/
.coverage

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Playwright ────────────────────────────────────────────────────────────────
# Keep artifacts/ tracked (has .gitkeep) but ignore generated screenshots/videos
frontend/artifacts/*.png
frontend/artifacts/*.jpg
frontend/artifacts/*.webm
frontend/playwright-report/
frontend/playwright-results.json
frontend/playwright-results.xml
frontend/test-results/

# ── Terraform ─────────────────────────────────────────────────────────────────
infrastructure/terraform/.terraform/
infrastructure/terraform/.terraform.lock.hcl
infrastructure/terraform/tfplan
infrastructure/terraform/tfplan-*
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/.terraform.tfstate.lock.info

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Azure Functions local settings ───────────────────────────────────────────
azure-functions/local.settings.json
